# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
#
# angie + statically linked SSL, production image.
# SSL_IMPL=boringssl|openssl selects the library; the runtime stage is the
# same for both. SSL_COMMIT is resolved outside the build (build.sh) and
# stamped into an image label — a "fetch HEAD" inside a cached layer would
# silently rebuild nothing.
#
# Every input is pinned: tarballs by sha256 (ARGs sit next to the RUN that
# verifies them), git by full commit hash, images by digest, apt by
# snapshot.debian.org date. Mutable references would break "same inputs,
# same image". Renovate/Dependabot can bump the FROM digests and ARG
# versions.
#
# Reproducibility: the runtime image is distroless plus a COPY of a
# /staging tree whose mtimes are normalized to SOURCE_DATE_EPOCH, so a
# rebuild from the same pins yields the same image digest. No apt runs in
# the runtime stage, so there is no apt residue to scrub there.
#
# No private keys exist anywhere in this build: certs and ECH keys are
# generated by the test harness (tests/) and mounted at deploy/test time.

ARG SSL_IMPL=boringssl

FROM debian:bookworm@sha256:30482e873082e906a4908c10529180aefb6f77620aea7404b909829fadc5d168 AS base

# Arbitrary fixed timestamp for reproducible file mtimes and image config
# timestamps; bump together with the version pins. Determinism is the only
# requirement — build.sh reads this default and passes it as a build arg so
# BuildKit also stamps image config/history times with it.
ARG SOURCE_DATE_EPOCH=1767225600
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# Apt from a dated snapshot: same SNAPSHOT_DATE, same package set.
# Check-Valid-Until off because snapshot Release files are expired by
# design; retries because snapshot.debian.org rate-limits. Sources are
# https from the first byte: apt's signatures prove the packages came from
# Debian, but nothing in them proves the snapshot date — with the validity
# check off, an attacker on the path of an http fetch could serve an
# older, still validly signed snapshot. TLS to the snapshot host is what
# enforces the date pin. The base image has no CA store yet, so the
# committed ISRG Root X1 is copied in and pinned via CAInfo. Its sha256
# fingerprint, checked against letsencrypt.org and the macOS system trust
# store when it was committed (re-check on any replacement):
#   96:BC:EC:06:26:49:76:F3:74:60:77:9A:CF:28:C5:A7:CF:E8:A3:C0:AA:E1:1A:8F:FC:EE:05:C0:BD:DF:08:C6
# If Debian ever switches CAs the build fails loudly; verify and replace
# the PEM. Note the flip side of a frozen snapshot: toolchain and runtime
# lib fixes arrive only when SNAPSHOT_DATE is bumped, so bump it on a
# schedule.
ARG SNAPSHOT_DATE=20260710T000000Z
COPY isrg-root-x1.pem /etc/apt/isrg-root-x1.pem
RUN printf 'deb https://snapshot.debian.org/archive/debian/%s bookworm main\ndeb https://snapshot.debian.org/archive/debian-security/%s bookworm-security main\ndeb https://snapshot.debian.org/archive/debian/%s bookworm-updates main\n' \
        "$SNAPSHOT_DATE" "$SNAPSHOT_DATE" "$SNAPSHOT_DATE" > /etc/apt/sources.list \
    && rm /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "3";\nAcquire::https::CAInfo "/etc/apt/isrg-root-x1.pem";\n' \
        > /etc/apt/apt.conf.d/99snapshot

# libssl-dev must never enter this environment. If system OpenSSL headers
# are installed, a wrong -I/-L in the BoringSSL branch makes angie's
# configure fall back to system OpenSSL with no error, and its summary
# output cannot tell the difference (verified in auto/lib/openssl/conf and
# auto/summary: both paths set OPENSSL=YES and print the same line).
# Checked at both levels — the package name, and the hazard itself: headers
# reachable at /usr/include/openssl, however they might have arrived. The
# openssl CLI (harness keygen) and libarchive-tools (bsdtar, for the image
# manifest in test.sh; builder images only) pull runtime libs at most.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gcc make libpcre2-dev zlib1g-dev openssl libarchive-tools \
    && rm -rf /var/lib/apt/lists/* \
    && if dpkg -s libssl-dev >/dev/null 2>&1; then \
        echo 'libssl-dev is installed; configure could silently fall back to system OpenSSL' >&2; exit 1; fi \
    && test ! -e /usr/include/openssl

ARG ANGIE_VERSION=1.11.8
# sha256 of angie-${ANGIE_VERSION}.tar.gz. Cross-checked against the
# GPG-signed apt Sources index (angie_${ANGIE_VERSION}.orig.tar.gz — same
# content, independent provenance). Update together with ANGIE_VERSION.
ARG ANGIE_SHA256=849897c78f79c3b04d035778e34993a92188e6bd2c0c3ba8ce3ad5eb1505ebd3
WORKDIR /build
RUN curl -fsSL -o angie.tar.gz \
        "https://download.angie.software/files/angie-${ANGIE_VERSION}.tar.gz" \
    && echo "${ANGIE_SHA256}  angie.tar.gz" | sha256sum -c - \
    && tar xzf angie.tar.gz && mv "angie-${ANGIE_VERSION}" angie \
    && rm angie.tar.gz

# Reproducibility: angie (unlike nginx) embeds a build timestamp —
# auto/make compiles ngx_build.c with -DANGIE_BUILD_TIMESTAMP=`date +%s`,
# wall clock, ignoring SOURCE_DATE_EPOCH. Pin it; grep proves the patch
# took (hard error if the upstream string changes).
RUN sed -i 's/\\`date +%s\\`/'"${SOURCE_DATE_EPOCH}"'/' /build/angie/auto/make \
    && grep -q "ANGIE_BUILD_TIMESTAMP=${SOURCE_DATE_EPOCH}" /build/angie/auto/make

# Binary hardening flags, spelled out. Debian's gcc defaults give PIE but
# not stack protector, FORTIFY, or BIND_NOW — dpkg-buildflags injects those
# into package builds, and a raw configure && make never gets them
# (verified: the unhardened binary had none of the three). check-harden
# below proves they took effect on every build.
ENV HARDEN_CC="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong" \
    HARDEN_LD="-Wl,-z,relro,-z,now"

# Shared configure flags (both flavors). --user/--group at compile time so
# the worker privilege drop holds even when ops mounts a config without a
# `user` directive (angie's compiled-in fallback is nobody, not angie).
# Temp paths under /var/cache/angie so the rootfs can be read-only with one
# tmpfs. Absolute paths only — configure quietly falls back on relative
# ones. Kept as one env var so a future Debian package can lift the exact
# flag set into debian/rules.
ENV CONFIGURE_COMMON="\
    --prefix=/usr/local/angie \
    --sbin-path=/usr/sbin/angie \
    --conf-path=/etc/angie/angie.conf \
    --pid-path=/run/angie.pid \
    --error-log-path=/dev/stderr \
    --http-log-path=/dev/stdout \
    --user=angie \
    --group=angie \
    --http-client-body-temp-path=/var/cache/angie/client_temp \
    --http-proxy-temp-path=/var/cache/angie/proxy_temp \
    --http-fastcgi-temp-path=/var/cache/angie/fastcgi_temp \
    --http-uwsgi-temp-path=/var/cache/angie/uwsgi_temp \
    --http-scgi-temp-path=/var/cache/angie/scgi_temp \
    --with-http_ssl_module \
    --with-http_v3_module"

# Staging-tree assembly, shared shape for both flavors (kept as a script so
# the two builder stages cannot drift): everything the runtime image adds on
# top of distroless, with mtimes normalized to SOURCE_DATE_EPOCH for
# reproducible COPY layers. /etc/passwd + group REPLACE the distroless ones
# (root + angie only). Empty dirs are mountpoints/workdirs: certs (ops
# mounts keys), http.d default can be mounted over, /var/cache/angie and
# /run are tmpfs targets when running --read-only (master creates and
# chowns the temp subdirs at startup).
RUN printf '%s\n' '#!/bin/sh' 'set -e' \
        'mkdir -p /staging/usr/sbin /staging/etc/angie/http.d /staging/etc/angie/certs /staging/var/cache/angie /staging/run /staging/usr/local/angie' \
        'cp /build/angie/objs/angie /staging/usr/sbin/angie' \
        'strip /staging/usr/sbin/angie' \
        '# ship every dynamic dep distroless base lacks (libc/libm/ld are in the base): pcre2, zlib, libcrypt, and for the BoringSSL flavor libstdc++/libgcc_s' \
        'for f in $(ldd /build/angie/objs/angie | awk "\$3 ~ /^\// && \$3 !~ /libc\.so|libm\.so|ld-linux/ {print \$3}"); do d="$(dirname "$(readlink -f "$f")")"; mkdir -p "/staging$d"; cp -L "$f" "/staging$d/"; done' \
        'printf "root:x:0:0:root:/root:/usr/sbin/nologin\nangie:x:101:101:angie:/nonexistent:/usr/sbin/nologin\n" > /staging/etc/passwd' \
        'printf "root:x:0:\nangie:x:101:\n" > /staging/etc/group' \
        'cp /build/conf/angie.conf /staging/etc/angie/angie.conf' \
        'cp /build/conf/http.d/default.conf /staging/etc/angie/http.d/default.conf' \
        'find /staging -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +' \
        > /usr/local/bin/stage-runtime && chmod +x /usr/local/bin/stage-runtime

# Shipped-conf validation, run in each builder after make: the harness mounts
# tests/http.d OVER the shipped http.d, so without this no path ever parses
# conf/ as shipped — a typo would build green, test green, and crash-loop the
# first deploy that doesn't mount a config. Throwaway cert + angie passwd
# entry because the conf references /etc/angie/certs and the compiled-in
# --user=angie must resolve; builder layers never ship, so neither leaks.
RUN printf '%s\n' '#!/bin/sh' 'set -e' \
        'mkdir -p /etc/angie/certs /var/cache/angie' \
        'cp -R /build/conf/. /etc/angie/' \
        'openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 1 -keyout /etc/angie/certs/server.key -out /etc/angie/certs/server.crt -subj "/CN=throwaway" 2>/dev/null' \
        'grep -q "^angie:" /etc/passwd || echo "angie:x:101:101::/nonexistent:/usr/sbin/nologin" >> /etc/passwd' \
        'grep -q "^angie:" /etc/group || echo "angie:x:101:" >> /etc/group' \
        '/build/angie/objs/angie -t' \
        > /usr/local/bin/check-conf && chmod +x /usr/local/bin/check-conf

# check-harden: prove the hardening flags took effect on the built binary —
# PIE, full RELRO (BIND_NOW), stack protector, and FORTIFY (_chk imports;
# angie calls fortifiable glibc functions, so zero imports means FORTIFY
# was off).
RUN printf '%s\n' '#!/bin/sh' 'set -e' 'b=/build/angie/objs/angie' \
        'readelf -d "$b" | grep -qE "Flags:.*PIE" || { echo "binary is not PIE" >&2; exit 1; }' \
        'readelf -d "$b" | grep -qE "BIND_NOW|Flags:.*NOW" || { echo "no BIND_NOW: partial RELRO only" >&2; exit 1; }' \
        'readelf --dyn-syms -W "$b" | grep -q __stack_chk_fail || { echo "no stack protector in binary" >&2; exit 1; }' \
        'readelf --dyn-syms -W "$b" | grep -q "_chk@" || { echo "no _chk imports: FORTIFY did not take" >&2; exit 1; }' \
        > /usr/local/bin/check-harden && chmod +x /usr/local/bin/check-harden

# conf/ is deliberately NOT copied here: base feeds both builder stages, so
# a conf edit this early would recompile BoringSSL and angie for nothing.
# Each builder copies it after its compile, just before the steps that
# read it (check-conf, stage-runtime).


FROM base AS build-boringssl
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake ninja-build git g++ \
    && rm -rf /var/lib/apt/lists/* \
    && if dpkg -s libssl-dev >/dev/null 2>&1; then \
        echo 'a build dep pulled in libssl-dev; configure could silently fall back to system OpenSSL' >&2; exit 1; fi \
    && test ! -e /usr/include/openssl

# BoringSSL commit hash, resolved outside the build (build.sh).
ARG SSL_COMMIT
RUN test -n "$SSL_COMMIT" || { echo 'SSL_COMMIT build arg required' >&2; exit 1; }
# Shallow fetch-by-SHA (googlesource allows it): content-addressed — we get
# exactly the stamped commit or a hard error, and no dependence on ref state
# at fetch time. build.sh guarantees SSL_COMMIT is a full 40-hex hash.
RUN git init /build/boringssl \
    && git -C /build/boringssl fetch --depth 1 \
        https://boringssl.googlesource.com/boringssl "$SSL_COMMIT" \
    && git -C /build/boringssl checkout --detach FETCH_HEAD
# No Go: only needed for BoringSSL tests (BUILDING.md). Build only the
# targets we need — the default target includes tests, which trip
# gcc-12 -Werror false positives and waste time. bssl is kept for the test
# harness ECH keygen (builder image only, never shipped).
RUN cmake -S /build/boringssl -B /build/boringssl/build \
        -GNinja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS="$HARDEN_CC" -DCMAKE_CXX_FLAGS="$HARDEN_CC" \
    && ninja -C /build/boringssl/build ssl crypto bssl

# The .a files land in build/ssl + build/crypto in older BoringSSL trees
# and at the top of build/ in newer ones. Detect which; guessing wrong
# would send configure back to system OpenSSL without a word.
RUN if [ -f /build/boringssl/build/ssl/libssl.a ]; then \
        printf -- '-L/build/boringssl/build/ssl -L/build/boringssl/build/crypto' \
            > /build/ssl-ldflags; \
    elif [ -f /build/boringssl/build/libssl.a ]; then \
        printf -- '-L/build/boringssl/build' > /build/ssl-ldflags; \
    else \
        echo 'libssl.a not found in BoringSSL build tree' >&2; exit 1; \
    fi

# Before configure runs, prove the -I path actually serves BoringSSL
# headers — a typo here would otherwise surface as a silent fallback.
RUN printf '#include <openssl/base.h>\n#ifndef OPENSSL_IS_BORINGSSL\n#error not boringssl\n#endif\n' \
        | cc -I/build/boringssl/include -fsyntax-only -x c -

# BoringSSL contains C++, so the link needs -lstdc++ — and it must come
# after -lssl -lcrypto. Putting it in --with-ld-opt does not work: configure
# places that before the feature-test libs, the linker drops the early
# -lstdc++, the C++ runtime symbols in the static archives stay undefined,
# and configure reports "OpenSSL library ... not found". So patch the
# feature libs instead; the grep fails the build if the upstream string
# ever changes shape.
RUN sed -i 's/-lssl -lcrypto \$NGX_LIBDL/-lssl -lcrypto -lstdc++ $NGX_LIBDL/' \
        /build/angie/auto/lib/openssl/conf \
    && grep -q -- '-lcrypto -lstdc++' /build/angie/auto/lib/openssl/conf

RUN cd /build/angie && ./configure \
        $CONFIGURE_COMMON \
        --with-cc-opt="-I/build/boringssl/include $HARDEN_CC" \
        --with-ld-opt="$(cat /build/ssl-ldflags) $HARDEN_LD" \
        || { cat objs/autoconf.err >&2; exit 1; } \
    && make -j"$(nproc)"

# After make, the binary itself is the proof: it must name BoringSSL and
# must not link libssl/libcrypto dynamically.
RUN /build/angie/objs/angie -V 2>&1 | grep -qi boringssl \
    && ! ldd /build/angie/objs/angie | grep -qE 'libssl|libcrypto'

RUN check-harden
COPY conf/ /build/conf/
RUN check-conf
RUN stage-runtime


FROM base AS build-openssl
# OpenSSL 4.0+ ships ECH (RFC 9849) and the QUIC TLS API angie's
# NGX_QUIC_OPENSSL_API path uses (>= 3.5). SSL_COMMIT = OpenSSL tag,
# e.g. "openssl-4.0.1".
# OpenSSL's Configure is perl and needs more than bookworm's perl-base
# (FindBin et al). perl does not pull libssl-dev; re-checked below anyway.
RUN apt-get update && apt-get install -y --no-install-recommends perl \
    && rm -rf /var/lib/apt/lists/* \
    && if dpkg -s libssl-dev >/dev/null 2>&1; then \
        echo 'a build dep pulled in libssl-dev; configure could silently fall back to system OpenSSL' >&2; exit 1; fi \
    && test ! -e /usr/include/openssl

ARG SSL_COMMIT
RUN test -n "$SSL_COMMIT" || { echo 'SSL_COMMIT build arg required' >&2; exit 1; }
# sha256 of ${SSL_COMMIT}.tar.gz, keyed to openssl-4.0.1 — matches the
# .sha256 published with the release (GitHub tag names pin intent, not
# content; release assets are re-uploadable). Update together with the tag.
ARG OPENSSL_SHA256=2db3f3a0d6ea4b59e1f094ace2c8cd536dffb87cdc39084c5afa1e6f7f37dd09
RUN curl -fsSL -o openssl.tar.gz \
        "https://github.com/openssl/openssl/releases/download/${SSL_COMMIT}/${SSL_COMMIT}.tar.gz" \
    && echo "${OPENSSL_SHA256}  openssl.tar.gz" | sha256sum -c - \
    && mkdir /build/openssl \
    && tar xzf openssl.tar.gz -C /build/openssl --strip-components=1 \
    && rm openssl.tar.gz

# Native --with-openssl: angie builds it in-tree during make — no
# header-shadow trick, no silent-fallback class. ECH ships in 4.0 as a
# default feature; enable-ech is a valid Configure flag and pins the intent
# (a no-ech build would then hard-fail). The in-tree openssl binary
# (/build/openssl/.openssl/bin/openssl) is kept for the test harness ECH
# keygen (builder image only, never shipped). OpenSSL honors
# SOURCE_DATE_EPOCH for its embedded build date.
# -Wno-error=array-bounds: gcc-12 false positive in the fortified memcpy
# wrapper at ngx_event_quic_ssl.c (OpenSSL QUIC path only — BoringSSL flavor
# compiles clean) trips angie's -Werror when FORTIFY is on. Demoted to a
# visible warning, not disabled; drop when the builder moves past gcc-12.
RUN cd /build/angie && ./configure \
        $CONFIGURE_COMMON \
        --with-cc-opt="$HARDEN_CC -Wno-error=array-bounds" \
        --with-ld-opt="$HARDEN_LD" \
        --with-openssl=/build/openssl \
        --with-openssl-opt="enable-ech $HARDEN_CC" \
        || { cat objs/autoconf.err >&2; exit 1; } \
    && make -j"$(nproc)"

# After make, the binary must name the pinned OpenSSL version (the full
# phrase — a bare version string could match by accident) and must not
# link libssl/libcrypto dynamically.
RUN /build/angie/objs/angie -V 2>&1 | grep -qF "built with OpenSSL ${SSL_COMMIT#openssl-}" \
    && ! ldd /build/angie/objs/angie | grep -qE 'libssl|libcrypto'

RUN check-harden
COPY conf/ /build/conf/
RUN check-conf
RUN stage-runtime


FROM build-${SSL_IMPL} AS build


FROM gcr.io/distroless/base-nossl-debian12@sha256:381b2d6ab802e5077611eea2be4f3872e0b5af565624cafb427e1b3aedebb612 AS runtime
# Distroless, nossl variant: glibc + CA certs, no shell, no apt/dpkg — and
# no libssl3/libcrypto3/engines/ossl-modules. The plain base ships those,
# angie (static SSL) never loads them, and they would float with the base
# digest rather than SSL_COMMIT: a second TLS stack that exists only to
# show up in CVE scans. The dynamic deps angie does need (libpcre2, zlib)
# ride along in the staging tree from the digest-pinned bookworm builder;
# same Debian 12 glibc, so the ABI matches.
COPY --from=build /staging/ /

# Certs and ECH keys are ops-supplied at deploy time, never baked:
#   docker run -p 443:443/tcp -p 443:443/udp \
#     --read-only --tmpfs /run --tmpfs /var/cache/angie:rw,size=64m \
#     --security-opt no-new-privileges \
#     --cap-drop=ALL --cap-add=NET_BIND_SERVICE --cap-add=SETUID \
#     --cap-add=SETGID --cap-add=CHOWN \
#     -v <keys>:/etc/angie/certs:ro [-v <conf>:/etc/angie/http.d:ro] angie:<flavor>
EXPOSE 443/tcp 443/udp
STOPSIGNAL SIGQUIT

# Stamping is mandatory: successive BoringSSL HEAD pins are different builds;
# the labels are the provenance record. Tag short-hash is convenience only —
# org.opencontainers.image.revision + ssl-commit here are authoritative.
ARG SSL_IMPL
ARG SSL_COMMIT
ARG ANGIE_VERSION
ARG BUILD_REVISION=""
# BUILD_CREATED is the RFC 3339 rendering of SOURCE_DATE_EPOCH
# (build-env.sh) — derived, never wall clock, so it cannot break the
# double-build digest comparison. There is no org.opencontainers.image.source
# label: OCI defines it as the repository URL, and no public remote exists
# yet. A slug violates the spec and a fake URL is worse; add it when the
# repo has a public home.
ARG BUILD_CREATED=""
LABEL org.opencontainers.image.title="angie" \
      org.opencontainers.image.version="${ANGIE_VERSION}" \
      org.opencontainers.image.revision="${BUILD_REVISION}" \
      org.opencontainers.image.created="${BUILD_CREATED}" \
      org.angie-build.ssl-impl="${SSL_IMPL}" \
      org.angie-build.ssl-commit="${SSL_COMMIT}"

CMD ["/usr/sbin/angie", "-g", "daemon off;"]
